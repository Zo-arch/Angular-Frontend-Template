# example-project — copy to .env and adjust for your environment
# Note: Angular typically uses src/environments/*.ts at build time.
# Keep this file as a documented list of values your team will wire later.

# Application
APP_NAME=example-project
APP_ENV=development

# API
API_BASE_URL=http://localhost:8080/api

# Feature flags (optional)
# FEATURE_EXAMPLE=false
